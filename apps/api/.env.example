# apps/api — copy to `.env.local` for non-Doppler local dev.
# Real production values live in Doppler (project: advicelink-api).
#
# Per REBUILD_PLAN §11.5 the only file that may read these is `src/config/env.ts`.
# Inventory: REBUILD_PLAN §19.19.1.

# ─── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
RATE_LIMIT_PER_MIN_DEFAULT=600

# ─── URLs ──────────────────────────────────────────────────────────────────────
# Default API port is 4001 (3001 is reserved for legacy CRA/dev servers — easier
# than fighting for a port). Web app runs on 3000.
APP_BASE_URL=http://localhost:4001
WEB_BASE_URL=http://localhost:3000

# Tenancy resolution. Path-prefix at v1 — flip to true once Cloudflare DNS lands.
SUBDOMAIN_ENABLED=false

# ─── Datastores ───────────────────────────────────────────────────────────────
# Railway exposes two URLs per service. The internal `*_URL` is only routable
# from inside Railway's private network; the `*_PUBLIC_URL` is the TCP-proxy
# address that works from your laptop. The env loader auto-prefers `*_PUBLIC_URL`
# when present, so deployed Railway services use the (free, fast) internal URL
# and local dev uses the public proxy. Paste both from Railway → service →
# Variables tab. Public networking must be enabled (service → Settings →
# Networking → Generate Domain).
DATABASE_URL=postgresql://postgres:PASSWORD@postgres.railway.internal:5432/railway
DATABASE_PUBLIC_URL=postgresql://postgres:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
REDIS_URL=redis://default:PASSWORD@redis.railway.internal:6379
REDIS_PUBLIC_URL=redis://default:PASSWORD@HOST.proxy.rlwy.net:PORT

# ─── AWS S3 (deferred — needed from WP-4 onward) ───────────────────────────────
S3_BUCKET=advicelink-dev
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# ─── Firebase Admin SDK (project: clarity-aa6d1) ───────────────────────────────
# From Project Settings → Service accounts → Generate new private key.
# In the downloaded JSON these are: `project_id`, `client_email`, `private_key`.
# IMPORTANT: keep the surrounding quotes on FIREBASE_PRIVATE_KEY; the env loader
# converts the literal \n sequences back into real newlines.
FIREBASE_PROJECT_ID=clarity-aa6d1
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Public Web SDK API key — `firebaseConfig.apiKey` from the Firebase
# console. Used only by the get-id-token CLI smoke-test script. Public,
# but stored in Doppler so any developer can run the script without
# needing a separate config file.
FIREBASE_WEB_API_KEY=

# ─── Anthropic Claude (deferred — needed from WP-8) ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-7-sonnet-20250219

# ─── DocuSign (deferred — WP-10) ───────────────────────────────────────────────
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
DOCUSIGN_WEBHOOK_BASE_URL=
DOCUSIGN_WEBHOOK_SECRET=

# ─── Microsoft Graph calendar (deferred — WP-13) ──────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TENANT=common

# ─── Google Calendar (Phase B) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─── OmniLife (Phase B insurance quoting — WP-13) ─────────────────────────────
OMNILIFE_USERNAME=
OMNILIFE_PASSWORD=
OMNILIFE_BASE_URL=
OMNILIFE_GROUP_ID=ExampleGroup

# ─── SendGrid (deferred — WP-12) ──────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

# ─── Observability (optional, can be empty locally) ───────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://app.posthog.com
HONEYCOMB_API_KEY=
OTEL_SERVICE_NAME=api
