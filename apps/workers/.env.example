# apps/workers — copy to `.env.local` for non-Doppler local dev.
# Real production values live in Doppler (project: advicelink-workers).
# Inventory: REBUILD_PLAN §19.19.2.

NODE_ENV=development
LOG_LEVEL=debug
OTEL_SERVICE_NAME=workers

# Same DATABASE_URL + REDIS_URL as apps/api (paste from Railway).
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:PORT/railway
REDIS_URL=redis://default:PASSWORD@HOST:PORT

# AWS S3 (deferred — WP-4 onward)
S3_BUCKET=advicelink-dev
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KMS_KEY_ID=

# Worker tuning — overrides only if you need to deviate from defaults.
WORKER_QUEUES=documents,ai,esign,cron,virusScan
WORKER_CONCURRENCY_DOCUMENTS=4
WORKER_CONCURRENCY_AI=2

# Optional virus scanner (ClamAV) — only required for client uploads (post WP-9).
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Anthropic / DocuSign / OmniLife / SendGrid — same shape as apps/api;
# fill in only when the matching processor is being worked on.
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-7-sonnet-20250219
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_URI=https://demo.docusign.net/restapi
OMNILIFE_USERNAME=
OMNILIFE_PASSWORD=
OMNILIFE_BASE_URL=
OMNILIFE_GROUP_ID=ExampleGroup
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=

SENTRY_DSN=
HONEYCOMB_API_KEY=
