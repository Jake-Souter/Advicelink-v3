# apps/web — copy to `.env.local` for non-Doppler local dev.
# Real production values live in Doppler (project: advicelink-web).
#
# Vite only exposes vars prefixed with VITE_ to the browser bundle.
# Per REBUILD_PLAN §11.5 the only file that may read these is `src/config/env.ts`.

VITE_API_BASE_URL=http://localhost:3001

# Firebase Web SDK (project: clarity-aa6d1 — reused from legacy so users carry over).
# These values are inherently public — Firebase publishes them in the client bundle.
VITE_FIREBASE_API_KEY=AIzaSyD1vz2Pa6te_06YZB2rrvKG6lgQ2cmMU-Q
VITE_FIREBASE_AUTH_DOMAIN=clarity-aa6d1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=clarity-aa6d1
VITE_FIREBASE_APP_ID=1:515546004923:web:e80eba08acc97c0765589e

# Optional observability — leave blank locally
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com

# Locale defaults — see REBUILD_PLAN §19.18
VITE_DEFAULT_TIMEZONE=Australia/Sydney

# Build metadata (CI overrides with the real SHA)
VITE_GIT_SHA=dev
